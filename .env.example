# ---- JFTools configuration ----
# Used for LOCAL development (run.bat / uvicorn): copy to .env and fill in real
# values. (.env is gitignored and never committed or baked into the image.)
# In Docker, values are set in docker-compose.yml instead; this file is unused.

# Jellyfin connection. The API root, not the web player URL ("/web" is stripped
# automatically). Use the LAN address while testing; the DuckDNS host should be
# https:// to avoid sending the API key in cleartext.
JELLYFIN_URL=http://YOUR-SERVER:8096
JELLYFIN_API_KEY=

# App login. Optional: if BOTH are set the first-run setup is skipped and these
# become the local login (stored as a scrypt hash once changed on the Settings
# page). Leave unset to choose a login on first launch instead.
# JFTOOLS_USERNAME=admin
# JFTOOLS_PASSWORD=

# Signs the session cookie. If unset, one is generated and persisted to /data.
# Set a stable value when running across restarts/replicas.
JFTOOLS_SECRET_KEY=

# Set to true when JFTools is served over HTTPS (e.g. behind a reverse proxy).
JFTOOLS_COOKIE_SECURE=false

# Where settings and other state are persisted (defaults to ./data locally;
# /data inside the Docker container).
# JFTOOLS_DATA_DIR=./data

# Container time zone (also settable in-app on the Settings page).
TZ=Europe/Stockholm
JFTOOLS_TIMEZONE=Europe/Stockholm

# Radarr/Sonarr URL prefixes (used by the Movie Match tab's "Open Radarr"/"Open Sonarr" links).
# Changeable on the Settings page; these are just the initial defaults.
JFTOOLS_RADARR_URL=
JFTOOLS_SONARR_URL=

# Map Jellyfin's container paths to paths this machine can open, so JFTools can
# read the real files (e.g. for ffmpeg). Semicolon-separated from=to pairs.
# Also editable in-app on Settings → Media paths.
# JFTOOLS_PATH_MAP=/Filmer=\\NAS\Filmer;/Ero=Z:\Ero

# Optional: explicit path to an ffprobe binary for the subtitle scans.
# By default JFTools looks for "ffprobe" on PATH, then a bundled Tools/ffprobe.exe.
# JFTOOLS_FFPROBE=C:\path\to\ffprobe.exe

# Web server bind (used by run.bat locally; the container listens on 8099).
JFTOOLS_HOST=0.0.0.0
JFTOOLS_PORT=8099
